    "seed": "bun --env-file=../../.env scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@salonstaff/config": "workspace:*",
    "drizzle-kit": "^0.31.11"

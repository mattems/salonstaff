# Copied to .env by `bun run setup`. Local values only; nothing here is secret.
# Used by the database scripts (migrate, seed, staff, studio). The Workers read .dev.vars.

# Postgres in Docker (see docker-compose.yml)
POSTGRES_PORT=54349
DATABASE_URL=postgres://salonstaff:salonstaff@localhost:54349/salonstaff

# The first staff member `bun run setup` adds, so the admin portal opens locally.
STAFF_EMAIL=you@example.com

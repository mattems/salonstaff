{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#dev:reader-login": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "extends": "@salonstaff/config/tsconfig.base.json",
  "compilerOptions": {
    // shadcn/ui components are written without this stricter setting.
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@salonstaff/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

# The API's origin (no trailing slash). It serves /v1/* and sign-in at /v1/auth/*.
# Defaults: http://localhost:8890 on the iOS simulator, http://10.0.2.2:8890 on the Android
# emulator (both `wrangler dev` from `bun dev`), https://api.salonstaff.com.au in release builds.
# On your phone, `bun run phone` / `bun run ios:device` (repo root) set it for you.
EXPO_PUBLIC_API_URL=http://localhost:8890

# The website, for share links and salon pages. Defaults to http://localhost:5300 in development
# (http://10.0.2.2:5300 on Android) and https://salonstaff.com.au in release builds.
# EXPO_PUBLIC_SITE_URL=http://localhost:5300

# The Apple team that signs builds is Studio 372 Pty Ltd's (ios.appleTeamId in app.json). To sign
# with another team, set it in .env.local, which git ignores.
# APPLE_TEAM_ID=XXXXXXXXXX

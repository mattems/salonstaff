# Base URL of the Salon Staff web/API server (no trailing slash, without /api/v1).
# Defaults to http://localhost:3000 (iOS simulator) or http://10.0.2.2:3000 (Android emulator).
# On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

{
  "expo": {
    "name": "Salon Staff",
    "slug": "salonstaff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salonstaff",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf7f5",
    "primaryColor": "#9d174d",
    "ios": {
      "bundleIdentifier": "au.com.salonstaff.app",
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "au.com.salonstaff.app",
      "adaptiveIcon": {
        "backgroundColor": "#faf7f5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf7f5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1c1917",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Salon Staff uses your photos so you can add a profile photo and portfolio of your work.",
          "cameraPermission": "Salon Staff uses the camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
